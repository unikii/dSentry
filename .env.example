# Copy to .env and adjust values
# dSentry core settings
# private: local username/password sign-in (single owner).
# public: OAuth-only multi-user sign-in (GitHub/Google).
RUN_MODE=private
# API version reported by /envs and the docs page.
APP_VERSION=0.1.0
# Set false to disable /docs, /redoc and /openapi.json on hardened deployments.
API_DOCS_ENABLED=true
SQLITE_PATH=data/dsentry.db

# VictoriaMetrics
VICTORIAMETRICS_URL=http://localhost:8428
# Optional basic auth for the VictoriaMetrics HTTP API. Leave blank when the
# database is only reachable on the private Compose network / loopback. If you
# set these, also start VictoriaMetrics with matching -httpAuth.* flags.
VICTORIAMETRICS_USERNAME=
VICTORIAMETRICS_PASSWORD=
# Retention passed to VictoriaMetrics' -retentionPeriod. A bare number means
# months; h/d/w/M/y suffixes are supported. Minimum is 24h/1d.
# Examples: 12, 1y, 100y (100y is displayed as "Forever" in the UI).
VICTORIAMETRICS_RETENTION=12

# JWT
# Leave empty to auto-generate on first start (private and public modes).
# A random secret is persisted to data/jwt_secret (0600, next to the SQLite
# file); deleting that file invalidates all issued tokens. Set JWT_SECRET
# explicitly if you prefer managed secrets.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Global limits
GLOBAL_NODE_PER_USER=20
# Soft per-push limit (bounds one push payload, not lifetime registrations)
GLOBAL_DEVICE_PER_NODE=99
# Push interval in minutes
GLOBAL_PUSH_INTERVAL=30
# Lookback window for the dashboard's "latest sample" query, in hours (1-720).
# It only needs to cover a few push intervals; 48 is plenty for the default.
LATEST_METRICS_LOOKBACK_HOURS=48
# Raw push settings
GLOBAL_RAW_PUSH_BASE=day
GLOBAL_RAW_PUSH_FREQ=1
GLOBAL_RAW_PUSH_PLAIN=true

# SMTP for email notifications
# Format: mailtos://user:pass@smtp.example.com:587?from=noreply%40example.com
# mailto:// = plain SMTP, mailtos:// = SMTP with STARTTLS/SSL
SMTP_URL=
CORS_ALLOWED_ORIGINS=
# Trust X-Forwarded-For / X-Real-IP from the reverse proxy (needed for
# per-client login rate limiting behind Caddy/Nginx). Set false if the API
# port is reachable directly by untrusted clients.
TRUST_PROXY_HEADERS=true

# Login page banner (shown on login page when set)
# e.g. "THIS only for tests, may not guarantee service SLA"
LOGIN_NOTIFY_BANNER=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed OAuth redirect origins
# e.g. https://example.com,http://localhost:3000
# Set one or more explicit origins before enabling OAuth
OAUTH_ALLOWED_ORIGINS=

# Set true only when this trusted instance must send alerts to a private
# network target such as a self-hosted Gotify or Mattermost server.
ALERT_ALLOW_PRIVATE_TARGETS=false

# Compose images and host port. Defaults use the upstream GHCR images; pin a
# vX.Y.Z tag in production or point these at your fork's images.
API_IMAGE=ghcr.io/unikii/dsentry/dsentry-api:latest
UI_IMAGE=ghcr.io/unikii/dsentry/dsentry-ui:latest
UI_PORT=3000

# UI build-time settings for source builds (docker compose build).
# The public API endpoint shown in the Add Node dialog; empty means
# <browser origin><VITE_API_BASE>. The repository is used by the one-line
# dsnode installers, so set it to your fork when publishing your own releases.
VITE_API_ENDPOINT=
VITE_GITHUB_REPO=unikii/dsentry
