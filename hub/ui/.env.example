# Base URL the browser uses to reach the Hub API.
# In dev, "/api" is proxied to the hub by vite (see vite.config.ts, target
# can be overridden with VITE_PROXY_TARGET). In docker, nginx proxies /api.
VITE_API_BASE=/api

# Public API endpoint shown in the dsnode install command
# (e.g. https://dsentry.example.com/api). Defaults to <origin><VITE_API_BASE>.
VITE_API_ENDPOINT=

# GitHub repo used by the one-line dsnode installers shown in Add Node dialog.
# Defaults to unikii/dsentry; set to your fork so installs pull your releases.
VITE_GITHUB_REPO=unikii/dsentry
