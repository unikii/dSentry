# private: local username/password sign-in (single owner).
# public: OAuth-only multi-user sign-in (GitHub/Google).
RUN_MODE=private
APP_VERSION=0.1.0
API_DOCS_ENABLED=true
SQLITE_PATH=data/dsentry.db
VICTORIAMETRICS_URL=http://localhost:8428
# Optional basic auth for the VictoriaMetrics HTTP API. If set, configure the
# same credentials on the VictoriaMetrics server with -httpAuth.* flags.
VICTORIAMETRICS_USERNAME=
VICTORIAMETRICS_PASSWORD=
# Passed to VictoriaMetrics' -retentionPeriod (bare number = months,
# minimum 24h/1d). Use 100y for effectively permanent retention.
VICTORIAMETRICS_RETENTION=12
# Leave empty to auto-generate to data/jwt_secret on first start.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

GLOBAL_NODE_PER_USER=20
GLOBAL_DEVICE_PER_NODE=99
GLOBAL_PUSH_INTERVAL=30
GLOBAL_RAW_PUSH_BASE=day
GLOBAL_RAW_PUSH_FREQ=1
GLOBAL_RAW_PUSH_PLAIN=true
LATEST_METRICS_LOOKBACK_HOURS=48

# SMTP_URL format: mailtos://user:pass@smtp.example.com:587?from=noreply%40example.com
# mailto:// = plain SMTP, mailtos:// = SMTP with STARTTLS/SSL
SMTP_URL=
CORS_ALLOWED_ORIGINS=

# OAuth configs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed OAuth redirect origins (e.g. https://example.com,http://localhost:3000)
# Set one or more explicit origins before enabling OAuth
OAUTH_ALLOWED_ORIGINS=

# Set true only for a trusted instance using a private notification server.
ALERT_ALLOW_PRIVATE_TARGETS=false

# Trust X-Forwarded-For / X-Real-IP from the reverse proxy. Enable only when
# the API is reachable exclusively through that proxy.
TRUST_PROXY_HEADERS=false
